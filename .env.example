# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Approval mode — SERVER ONLY.
#
# "blanket"  = the destructive freshness check is skipped (the failure mode).
# anything else, including unset = "step-up" (the freshness check is enforced).
#
# This is deliberately not NEXT_PUBLIC_. The browser and the agent must never
# be able to read or set it.
# ---------------------------------------------------------------------------
APPROVAL_MODE=step-up

# ---------------------------------------------------------------------------
# Identity provider (Kinde) — OIDC authorization code + PKCE
# ---------------------------------------------------------------------------
KINDE_ISSUER_URL=https://your-tenant.kinde.com
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_REDIRECT_URI=http://localhost:3001/api/auth/callback
KINDE_POST_LOGOUT_REDIRECT_URI=http://localhost:3001
# Audience of the registered demo API. Leave blank until the API is registered.
KINDE_AUDIENCE=
KINDE_SCOPES=openid profile email offline

# ---------------------------------------------------------------------------
# Anthropic — model id is configuration, never hardcoded
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Session cookie encryption. Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_SITE_URL=http://localhost:3001
DEFAULT_MAX_AUTH_AGE_SECONDS=300
CLOCK_SKEW_SECONDS=30

# ---------------------------------------------------------------------------
# Convex — written by `npx convex dev`
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
